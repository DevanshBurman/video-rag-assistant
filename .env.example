# ── Mistral AI API Configuration ──────────────────────────────────────────────
# Required for structured executive summary, action items, decisions, and RAG synthesis
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# ── Speech-to-Text Transcriber Backend ─────────────────────────────────────────
# Default: groq (cloud Whisper API, fast, uses negligible RAM on Render)
# Options: groq | local
TRANSCRIBER_BACKEND=groq

# Required if TRANSCRIBER_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── YouTube Cloud Proxy Configuration (Bypasses Datacenter IP Blocks) ─────────
# Generic HTTP/HTTPS proxy URL (e.g. http://user:pass@proxy.example.com:8080)
PROXY_URL=

# Or Webshare Rotating Residential Proxy Credentials (https://www.webshare.io/)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Optional: Netscape-formatted YouTube cookies content to bypass age/bot gates
YOUTUBE_COOKIES=

# ── Ingestion Limits & Security ───────────────────────────────────────────────
# Maximum video duration in minutes allowed for audio download (Default: 90)
MAX_VIDEO_MINUTES=90

# Admin verification token to protect /debug/youtube endpoint
ADMIN_TOKEN=your_secure_admin_token_here
