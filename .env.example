# AI Video Assistant (Video RAG) Environment Configuration

# Mistral AI API Key for Structured Synthesis (Summary, Action Items, Key Decisions)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b

# Whisper Model Size (tiny, base, small, medium, large-v3)
WHISPER_MODEL=base

# Sarvam AI API Key (Optional for bilingual Indic speech processing)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v2.5
